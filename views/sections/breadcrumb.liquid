{%- assign breadcrumbs = section.settings.breadcrumb | parse_json -%}
<div class="panel-space py-6 text-sm text-gray-500">
  {% for breadcrumb in breadcrumbs %}
    {% liquid
      if forloop.index0 == 0
        assign class_name = "font-bold text-primary"
      else
        assign class_name = ""
      endif
    %}

    {% if breadcrumb.url != "" %}
      <a href="{{ breadcrumb.url }}" class="{{ class_name }}">{{ breadcrumb.label }}</a>
    {% else %}
      <span class="{{ class_name }}">{{ breadcrumb.label }}</span>
    {% endif %}
    {% if forloop.last == false %}
      <i class="fa-light fa-chevron-right"></i>
    {% endif %}
  {% endfor %}
</div>